# Server Configuration
PORT=5001
# Production Frontend URL (e.g. https://your-seo-frontend.vercel.app or http://localhost:5173 for local)
FRONTEND_URL=https://your-frontend.vercel.app

# MongoDB Connection String (MongoDB Atlas)
# Required for serverless session & token storage
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority

# Google OAuth2 Credentials
# Configure in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# In production, must match the authorized redirect URI registered in Google Cloud:
# https://seoplusplus-backend.vercel.app/api/google/callback
GOOGLE_REDIRECT_URI=https://seoplusplus-backend.vercel.app/api/google/callback

# Optional HMAC State Secret (falls back to GOOGLE_CLIENT_SECRET if omitted)
GOOGLE_OAUTH_STATE_SECRET=optional_random_secret_string_for_oauth_csrf_signing

# Blog Content Management Admin Secret Key (used to authorize publishing & article management)
BLOG_ADMIN_KEY=your_secure_admin_secret_key_here

# Ahrefs API v3 Key (Site Explorer Domain Rating)
# Configure via Ahrefs Account -> Integrations -> API keys
AHREFS_API_KEY=your_ahrefs_api_key_here

